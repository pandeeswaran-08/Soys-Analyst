# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True
ENVIRONMENT=development

# Database (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=soydecision
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/soydecision

# Redis Cache
REDIS_URL=redis://localhost:6379/0

# Qdrant Vector Store
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=soy_market_intelligence

# CORS Origins (JSON list or comma-separated)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# LLM Providers (for LangGraph Agent)
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here
DEFAULT_LLM_PROVIDER=gemini
DEFAULT_MODEL_NAME=gemini-2.5-flash

