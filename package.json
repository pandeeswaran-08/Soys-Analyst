{
  "name": "soydecision-desk",
  "version": "0.1.0",
  "private": true,
  "description": "SoyDecision Desk - Soybean Procurement Decision Support System",
  "scripts": {
    "dev": "npm run dev:frontend",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && python -m uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload",
    "dev:all": "start /B npm run dev:backend & npm run dev:frontend",
    "build": "cd frontend && npm run build",
    "start": "cd frontend && npm run start",
    "lint": "cd frontend && npm run lint"
  }
}

